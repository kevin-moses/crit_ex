    "simulate": "node --env-file-if-exists=.env scripts/simulate.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
